{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:symctrl:part1-model:1.0.0",
  "title": "Part 1 immutable model package v1",
  "description": "Structural manifest schema. Cross-file counts, finite values, shapes, geometry and complete transition pairs require semantic validation; see docs/part1-to-part2.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "model_id",
    "model_parameters",
    "provenance",
    "source",
    "dimensions",
    "internal_states",
    "input_count",
    "outside_state_id",
    "grid",
    "semantics",
    "numeric_guarantee",
    "disturbance",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "model_parameters": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "provenance": {
      "enum": [
        "hand_authored_fixture",
        "generated_part1"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "input",
        "disturbance"
      ],
      "properties": {
        "state": {
          "type": "integer",
          "minimum": 1
        },
        "input": {
          "type": "integer",
          "minimum": 1
        },
        "disturbance": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "internal_states": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551614
    },
    "input_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "outside_state_id": {
      "const": 0
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "cells_per_dimension"
      ],
      "properties": {
        "domain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lo",
            "hi"
          ],
          "properties": {
            "lo": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "hi": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          }
        },
        "cells_per_dimension": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          }
        }
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_order",
        "input_order",
        "point_ownership",
        "cell_geometry",
        "successor_intersection",
        "outside_successors",
        "enabled_inputs"
      ],
      "properties": {
        "state_order": {
          "const": "dimension_0_fastest"
        },
        "input_order": {
          "enum": [
            "explicit_caller_order",
            "cartesian_dimension_0_fastest"
          ]
        },
        "point_ownership": {
          "const": "half_open_last_closed"
        },
        "cell_geometry": {
          "const": "closed"
        },
        "successor_intersection": {
          "const": "closure"
        },
        "outside_successors": {
          "const": "all_states"
        },
        "enabled_inputs": {
          "const": "all_states_all_inputs"
        }
      }
    },
    "numeric_guarantee": {
      "enum": [
        "uncertified_float",
        "validated_enclosure"
      ]
    },
    "disturbance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lo",
        "hi"
      ],
      "properties": {
        "lo": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "hi": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cells",
        "inputs",
        "transitions"
      ],
      "properties": {
        "cells": {
          "const": "cells.csv"
        },
        "inputs": {
          "const": "inputs.csv"
        },
        "transitions": {
          "const": "transitions.csv"
        }
      }
    }
  }
}
